{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5245" }
    }
  },
  "Strongroom": {
    // Full path to the vault database FILE (e.g. "C:\\Repository\\other\\vault\\data\\strongroom.db").
    // Leave empty to use the default: <repo root>\data\strongroom.db.
    // NOTE: changing this does NOT move an existing vault. Stop the app and copy the old
    // strongroom.db to the new location first, otherwise the app starts with a new, empty database there.
    "DatabasePath": ""
  }
}
